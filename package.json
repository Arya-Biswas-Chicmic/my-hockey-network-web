{
  "name": "my-hockey-network-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/ensure-package-manager.mjs",
    "package-manager:check": "node scripts/check-package-manager.mjs",
    "check:obscure": "node scripts/scan-obfuscation.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "security:check": "node scripts/check-security-baseline.mjs",
    "components:migrate": "node scripts/migrate-web-primitives.mjs",
    "components:check": "node scripts/check-component-reuse.mjs",
    "scan": "npm run check:obscure",
    "predev": "npm run check:obscure",
    "dev": "npm run dev:web",
    "prebuild": "npm run check:obscure",
    "build": "npm run build:web",
    "prestart": "npm run check:obscure",
    "start": "npm run dev:web",
    "pretypecheck": "npm run check:obscure",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prelint": "npm run check:obscure",
    "lint": "npm run lint:check",
    "prelint:check": "npm run check:obscure",
    "lint:check": "npm run lint:check --workspaces --if-present",
    "prelint:fix": "npm run check:obscure",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "pretest": "npm run check:obscure",
    "test": "vitest",
    "pretest:run": "npm run check:obscure",
    "test:run": "vitest --run",
    "pretest:coverage": "npm run check:obscure",
    "test:coverage": "vitest --run --coverage",
    "preformat": "npm run check:obscure",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\" \"scripts/**/*.{js,mjs}\"",
    "preverify": "npm run check:obscure",
    "verify": "npm run package-manager:check && npm run docs:check && npm run security:check && npm run components:check && npm run typecheck && npm run lint:check && npm run test:coverage && npm run build:web",
    "preprepare": "npm run check:obscure",
    "prepare": "husky",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "preview:web": "npm run build:web && npm run preview --workspace=apps/web -- --host 0.0.0.0",
    "deploy:web": "npm run build:web && npx netlify-cli deploy --prod --dir=apps/web/dist --filter @my-hockey-network/web",
    "deploy": "npm run deploy:web",
    "start:mobile": "npm run start --workspace=apps/mobile",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "android:mobile": "npm run android --workspace=apps/mobile",
    "ios:mobile": "npm run ios --workspace=apps/mobile",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "native:generate:mobile": "npm run native:generate --workspace=apps/mobile"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
