{
  "name": "my-hockey-network-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/ensure-package-manager.mjs",
    "package-manager:check": "node scripts/check-package-manager.mjs",
    "check:obscure": "node scripts/scan-obfuscation.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "security:check": "node scripts/check-security-baseline.mjs",
    "components:migrate": "node scripts/migrate-web-primitives.mjs",
    "components:check": "node scripts/check-component-reuse.mjs",
    "scan": "pnpm check:obscure",
    "predev": "pnpm check:obscure",
    "dev": "pnpm dev:web",
    "prebuild": "pnpm check:obscure",
    "build": "pnpm build:web",
    "prestart": "pnpm check:obscure",
    "start": "pnpm start:web",
    "pretypecheck": "pnpm check:obscure",
    "typecheck": "pnpm -r --if-present typecheck",
    "prelint": "pnpm check:obscure",
    "lint": "pnpm lint:check",
    "prelint:check": "pnpm check:obscure",
    "lint:check": "pnpm -r --if-present lint:check",
    "prelint:fix": "pnpm check:obscure",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "pretest": "pnpm check:obscure",
    "test": "vitest",
    "pretest:run": "pnpm check:obscure",
    "test:run": "vitest --run",
    "pretest:coverage": "pnpm check:obscure",
    "test:coverage": "vitest --run --coverage",
    "preformat": "pnpm check:obscure",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\" \"scripts/**/*.{js,mjs}\"",
    "preverify": "pnpm check:obscure",
    "verify": "pnpm package-manager:check && pnpm docs:check && pnpm security:check && pnpm components:check && pnpm typecheck && pnpm lint:check && pnpm test:coverage && pnpm build:web",
    "preprepare": "pnpm check:obscure",
    "prepare": "husky || true",

    "dev:web": "pnpm --filter @my-hockey-network/web dev",
    "build:web": "pnpm --filter @my-hockey-network/web build",
    "start:web": "pnpm --filter @my-hockey-network/web start",
    "preview:web": "pnpm build:web && pnpm start:web",
    "deploy:web": "pnpm build:web && pnpm dlx netlify-cli deploy --prod --dir=apps/web/.next --filter @my-hockey-network/web",
    "deploy": "pnpm deploy:web",
    "start:mobile": "pnpm --filter @my-hockey-network/mobile start",
    "dev:mobile": "pnpm --filter @my-hockey-network/mobile start",
    "android:mobile": "pnpm --filter @my-hockey-network/mobile android",
    "ios:mobile": "pnpm --filter @my-hockey-network/mobile ios",
    "build:mobile": "pnpm --filter @my-hockey-network/mobile build",
    "native:generate:mobile": "pnpm --filter @my-hockey-network/mobile native:generate"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }

}
