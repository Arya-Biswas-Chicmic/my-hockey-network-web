{
  "name": "@my-hockey-network/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "scan": "node ../../scripts/scan-obfuscation.mjs",
    "prestart": "pnpm scan",
    "start": "EXPO_NO_TELEMETRY=1 pnpm exec expo start",
    "preandroid": "pnpm scan",
    "android": "EXPO_NO_TELEMETRY=1 pnpm exec expo start --android",
    "preios": "pnpm scan",
    "ios": "EXPO_NO_TELEMETRY=1 pnpm exec expo start --ios",
    "prebuild": "pnpm scan",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "EXPO_NO_TELEMETRY=1 pnpm exec expo export --platform android --output-dir dist/android",
    "build:ios": "EXPO_NO_TELEMETRY=1 pnpm exec expo export --platform ios --output-dir dist/ios",
    "native:generate": "pnpm scan && EXPO_NO_TELEMETRY=1 pnpm exec expo prebuild --clean --skip-dependency-update react",
    "pretypecheck": "pnpm scan",
    "typecheck": "tsc --noEmit --pretty false",
    "prelint:check": "pnpm scan",
    "lint:check": "pnpm exec expo lint --max-warnings=2",
    "prelint:fix": "pnpm scan",
    "lint:fix": "pnpm exec expo lint --fix --max-warnings=2",
    "lint": "pnpm lint:check",
    "format": "prettier --write .",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@my-hockey-network/api-client": "workspace:*",
    "@my-hockey-network/auth": "workspace:*",
    "@my-hockey-network/contracts": "workspace:*",
    "@my-hockey-network/core": "workspace:*",
    "@my-hockey-network/domain": "workspace:*",
    "@my-hockey-network/validation": "workspace:*",
    "@my-hockey-network/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.102.4",
    "expo": "~54.0.30",
    "expo-asset": "~12.0.12",
    "expo-build-properties": "~1.0.10",
    "expo-font": "~14.0.10",
    "expo-splash-screen": "~31.0.13",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^25.1.3",
    "react": "19.1.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.81.5",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@dev-plugins/react-navigation": "^0.4.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "redux-devtools-expo-dev-plugin": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true
}
