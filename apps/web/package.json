{
  "name": "@my-hockey-network/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "scan": "node ../../scripts/scan-obfuscation.mjs",
    "predev": "npm run scan",
    "dev": "vite",
    "prebuild": "npm run scan",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run scan",
    "typecheck": "tsc -b --pretty false",
    "prelint:check": "npm run scan",
    "lint:check": "eslint . --max-warnings=2",
    "prelint:fix": "npm run scan",
    "lint:fix": "eslint . --fix --max-warnings=2",
    "lint": "npm run lint:check",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@my-hockey-network/api-client": "*",
    "@my-hockey-network/auth": "*",
    "@my-hockey-network/contracts": "*",
    "@my-hockey-network/core": "*",
    "@my-hockey-network/domain": "*",
    "@my-hockey-network/shared": "*",
    "@tanstack/react-query": "^5.102.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
