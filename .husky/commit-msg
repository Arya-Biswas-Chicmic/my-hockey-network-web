COMMITLINT_CLI="node_modules/@commitlint/cli/cli.js"

if [ ! -f "$COMMITLINT_CLI" ]; then
  echo "Husky commit-msg: local Commitlint is not installed."
  exit 127
fi

if command -v node >/dev/null 2>&1; then
  exec node "$COMMITLINT_CLI" --edit "$1"
fi

echo "Husky commit-msg: Node.js is not available."
exit 127
