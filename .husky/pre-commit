# Temporarily disable exit-on-error to allow NVM to load safely without crashing on internal checks
set +e

# Set PATH to include common macOS/Homebrew locations
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Load NVM if it exists
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
fi

# Re-enable exit-on-error
set -e

if command -v pnpm >/dev/null 2>&1; then
  pnpm check:obscure
  pnpm docs:check
  pnpm security:check
  pnpm components:check
  pnpm lint:check
else
  echo "Husky pre-commit: 'pnpm' not found."
  exit 127
fi
